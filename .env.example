# Copy this file to .env before you run docker compose:
#   cp .env.example .env
# .env stays on your machine. The repository git ignores it.

# Required. Shared secret the gateway demands on every route except /health.
# Generate one with: openssl rand -hex 32
NEXUS_GATEWAY_TOKEN=

# Optional. Browser origins allowed to call the gateway.
NEXUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Host header names the gateway accepts.
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://nexus:nexus@postgres:5432/nexusos
LOCAL_MAC_MOUNT=/workspace/local_mac_system
ICLOUD_DRIVE_MOUNT=/workspace/icloud_drive
NEXUS_LOG_DIR=/app/runtime/logs
NEXUS_PATCH_DIR=/app/runtime/patches
NEXUS_EXPORT_DIR=/app/runtime/exports

GEMINI_API_KEY=
GROQ_API_KEY=
SKYVERN_API_KEY=
SKYVERN_ALLOWED_DOMAINS=example.com,news.ycombinator.com
NEXUS_SELF_EVOLUTION=0

NEXT_PUBLIC_GATEWAY_URL=http://localhost:8088
NEXT_PUBLIC_WS_URL=ws://localhost:8088/ws/events
